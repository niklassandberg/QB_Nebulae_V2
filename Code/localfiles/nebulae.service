[Unit]
Description=Starts Nebulae
DefaultDependencies=false
# Not local-fs.target: its device nodes step sometimes hangs for seconds.
After=systemd-remount-fs.service tmp.mount
Wants=tmp.mount
# Dropped by DefaultDependencies=false; needed for ExecStopPost at reboot.
Conflicts=shutdown.target
Before=shutdown.target

[Service]
#ExecStart=/home/alarm/QB_Nebulae_V2/Code/scripts/startup.sh
ExecStartPre=-/usr/bin/rm -f /run/nebulae-fatal
# A fatal stop (fatal.py) also stopped sclang; it is otherwise only started at boot.
ExecStartPre=-/usr/bin/systemctl start --no-block sclang.service
ExecStart=/home/alarm/checkfirmware.sh
WorkingDirectory=/
Environment=PYTHONUTF8=1
Restart=on-failure
# 3: fatal.py stopped Nebulae (a file that is not UTF-8); a restart stops again.
RestartPreventExitStatus=3
RemainAfterExit=true
# LEDs dark while restarting, red after a fatal stop.
ExecStopPost=-/bin/sh /home/alarm/QB_Nebulae_V2/Code/scripts/nebulae_leds.sh
TimeoutStopSec=5
# No rate limit: log_level DEBUG writes more than journald allows.
SyslogIdentifier=nebulae
LogRateLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
