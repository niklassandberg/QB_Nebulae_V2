[Unit]
Description=Starts Nebulae
DefaultDependencies=false
# Not local-fs.target: its device nodes step sometimes hangs for seconds.
After=systemd-remount-fs.service tmp.mount
Wants=tmp.mount
# Dropped by DefaultDependencies=false; needed for ExecStopPost at reboot.
Conflicts=shutdown.target
Before=shutdown.target

[Service]
#ExecStart=/home/alarm/QB_Nebulae_V2/Code/scripts/startup.sh
ExecStart=/home/alarm/checkfirmware.sh
WorkingDirectory=/
Restart=on-failure
RemainAfterExit=true
# LEDs dark while restarting: the PCA9685 keeps its registers. Active low:
# full ON in ALL_LED_ON_H, full OFF cleared in ALL_LED_OFF_H (it wins).
ExecStopPost=-/usr/bin/i2cset -y 1 0x40 0xFB 0x10
ExecStopPost=-/usr/bin/i2cset -y 1 0x40 0xFD 0x00
TimeoutStopSec=5
# No rate limit: log_level DEBUG writes more than journald allows.
SyslogIdentifier=nebulae
LogRateLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
