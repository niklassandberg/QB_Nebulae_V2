[Unit]
# jack@<period>-<periods>-<rate>, e.g. jack@128-3-48000, started by
# nebulae.py. Never enabled at boot (no [Install] on purpose).
Description=JACK Audio Connection Kit, %i (period-periods-rate)
After=sound.target

[Service]
Type=simple
# $$ is a $ for the shell.
ExecStart=/bin/sh -c 'v=%i; IFS=-; set -- $$v; exec dbus-run-session /usr/bin/jackd --timeout 2000 -ndefault -R -P75 -dalsa -dhw:sndrpiproto -p$$1 -n$${2:-3} -s -r$${3:-48000}'
Restart=no
# See sclang.service.
LimitCORE=0
