[Unit]
Description=SuperCollider Language Server
# Early, like nebulae.service: sclang was the slowest step to sound.
DefaultDependencies=false
After=systemd-remount-fs.service tmp.mount
Wants=tmp.mount
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/
# tail keeps sclang's stdin open (it quits at end of input).
ExecStart=/bin/bash -c 'exec tail -f /dev/null | /usr/bin/sclang'
Restart=always
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sclang
# scsynth crashes on /quit (SC 3.14), and writing its core took ~25 s.
LimitCORE=0

[Install]
WantedBy=multi-user.target