# Nebulae kernel: changes on top of the Arch Linux ARM linux-rpi config
# (bcm2711_defconfig + archarm.diffconfig), applied by build_kernel.sh.
# The same kernel runs on a Pi 3 and a Pi 4 (bcm2711_defconfig covers both).
# Only what the Nebulae has no use for goes; everything it uses stays as it
# is: the I2S codec (WM8731, proto-codec overlay), SPI/I2C/GPIO, Ethernet of
# both Pis (genet, smsc95xx, lan78xx), the Pi's Wi-Fi (brcmfmac), USB audio,
# USB sticks (vfat, exfat, ntfs3), ext4.

# Full kernel preemption and no debug info: the stock config has both already
# (checked in report.txt); kept here so a new stock config cannot change them.
# No PREEMPT_RT: that costs throughput, and Csound already uses most of a
# core on a Pi 3.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set

# No screen: the Nebulae has no display (config.txt: hdmi_ignore_hotplug=1).
# CONFIG_DRM is not set
# No cameras, TV, video capture.
# CONFIG_MEDIA_SUPPORT is not set
# No Bluetooth (the Wi-Fi of the same chip stays).
# CONFIG_BT is not set
# No joysticks, tablets, touchscreens (keyboard/mouse and uinput stay).
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set

# Wi-Fi: only the Pi's own chip (Broadcom brcmfmac), no USB dongle drivers.
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set

# Network protocols and buses the Nebulae does not have.
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_HAMRADIO is not set
# CONFIG_IEEE802154 is not set

# File systems a Nebulae never sees (ext4 for the card, vfat/exfat/ntfs3 for
# USB sticks stay).
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
