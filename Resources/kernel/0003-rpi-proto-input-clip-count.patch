 	.dai_link	= snd_rpi_proto_dai,
 	.num_links	= ARRAY_SIZE(snd_rpi_proto_dai),
+	.controls	= snd_rpi_proto_controls,
+	.num_controls	= ARRAY_SIZE(snd_rpi_proto_controls),
 };
 
