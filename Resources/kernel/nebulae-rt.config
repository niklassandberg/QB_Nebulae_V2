# Nebulae real-time kernel: applied by "build_kernel.sh OUTDIR rt" on top of
# nebulae.config, so the RT kernel differs from the normal Nebulae kernel
# only in the preemption model. Name: -nebulae-rt, kernel8-nebulae-rt.img.
#
# PREEMPT_RT (mainline since 6.12, arm64 supported): spinlocks become
# sleeping, priority-inheriting locks and every interrupt handler runs as a
# kernel thread with its own priority (irq/NN-...), so a high-priority audio
# thread (jackd, Csound, scsynth, Pd, nebio) is not held up by other kernel
# work. Costs some throughput; the gain is lower, steadier latency, for
# smaller audio buffers and tighter CV/gate timing. The priorities are set
# from user space (chrt, systemd CPUSchedulingPolicy, jackd -R -P).
# Since 6.13 RT is not one of the preemption models but an option on top of
# one: CONFIG_PREEMPT=y (from nebulae.config) stays set. RCU_BOOST comes
# with it.
CONFIG_PREEMPT_RT=y
# Timer frequency stays at 250 Hz like the normal kernel (high-resolution
# timers do the precise wakeups), so an A/B shows only the RT change.
