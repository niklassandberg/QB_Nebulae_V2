# Csound for the Nebulae (aarch64): the Arch Linux ARM package (extra/csound
# 6.18.1-10, https://github.com/archlinuxarm/PKGBUILDs) with two fixes.
#
# 1. Optimised. ALARM's PKGBUILD sets CMAKE_C_FLAGS/CMAKE_CXX_FLAGS to its own
#    flags only, which replaces makepkg's CFLAGS (-O2 -march=...); with
#    CMAKE_BUILD_TYPE=None the whole of Csound is built WITHOUT optimisation.
#    On a Pi 3 granular_looper then needs 110 % of real time (constant
#    dropouts); built with the CFLAGS it needs 36 % (3x faster).
# 2. -B works again (rtalsa-buffer-size.patch): Csound 6.18 no longer passes
#    -B to the ALSA module, the buffer is always 1024 frames; 6.11 (the
#    original Qu-Bit system) used -B (instruments ask for -B 2048).
#
# Build on the Pi (aarch64, about 30 min on a Pi 3, needs the makedepends):
#   makepkg -s
# Install: Code/scripts/engines_check.sh (firmware update) installs the
# package from Code/engine_packages/ when the installed Csound is not this build.
#
# Maintainer (ALARM): Kevin Mihelich <kevin@archlinuxarm.org>
# Maintainer (Arch): David Runge <dvzrv@archlinux.org>
# Maintainer (Arch): Brett Cornwall <ainola@archlinux.org>
# Contributor: speps
# Contributor: Bernardo Barros

pkgname=csound
pkgver=6.18.1
# 10 = the Arch package this is based on, .1 = Nebulae build
pkgrel=10.1
pkgdesc="Programming language for sound rendering and signal processing (Nebulae build: optimised, -B fixed)"
arch=(aarch64)
url="https://csound.com"
license=(LGPL-2.1-or-later)
# As Arch, without java-environment (ALARM: no Java interface) and without
# what only the documentation and the jar need (doxygen, strip-nondeterminism).
makedepends=(
  alsa-lib
  cmake
  dssi
  fluidsynth
  hdf5
  jack
  ladspa
  libmusicxml
  libsamplerate
  libsndfile
  libwebsockets
  llvm
  lua
  openssl
  portaudio
  portmidi
  portsmf
  python
  stk
  swig
  wiiuse
)
depends=(
  curl libcurl.so
  glibc
  libgcc
  libstdc++
  libsamplerate libsamplerate.so
  libsndfile libsndfile.so
)
optdepends=(
  'alsa-lib: for librtalsa plugin'
  'csound-plugins: for additional opcodes'
  'hdf5: for hdf5ops plugin'
  'fluidsynth: for libfluidOpcodes plugin'
  'jack: for libjacko, librtjack and libjackTransport plugins'
  'liblo: for libosc plugin'
  'ncurses: for libfaustcsound plugin'
  'portmidi: for libpmidi plugin'
  'portaudio: for librtpa plugin'
  'libpulse: for librtpulse plugin'
  'stk: for libstkops plugin'
  'libwebsockets: for libwebsocketIO plugin'
  'wiiuse: for libwiimote plugin'
  'libx11: for libwidgets plugin'
  'lua: for LUA integration'
  'openssl: for libfaustcsound plugin'
  'python-numpy: For Csound Python bindings'
  'zlib: for libfaustcsound plugin'
)
provides=(
  libcsound64.so
  libcsnd6.so
)
source=(
  https://github.com/$pkgname/$pkgname/archive/$pkgver/$pkgname-$pkgver.tar.gz
  $pkgname.sh
  fixing-liblo-calls.patch::https://github.com/$pkgname/$pkgname/commit/596667daba1ed99eda048e491ff8f36200f09429.patch
  type-mismatch-in-OSC.patch::https://github.com/$pkgname/$pkgname/commit/2a071ae8ca89bc21b5c80037f8c95a01bb670ac9.patch
  rtalsa-buffer-size.patch
)
