prepare() {
  cd $pkgname-$pkgver
  patch -Np1 -i ../fixing-liblo-calls.patch
  patch -Np1 -i ../type-mismatch-in-OSC.patch
  patch -Np1 -i ../rtalsa-buffer-size.patch
}

build() {
  local cmake_options=(
    -B build
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_BUILD_TYPE=None
    # it's not allowed to redistribute the scansyn opcodes: https://github.com/csound/csound/issues/1148
    -D BUILD_SCANSYN_OPCODES=OFF
    -D LUA_LIBRARY=/usr/lib/liblua.so
    -D BUILD_STATIC_LIBRARY=ON
    # ALARM's flags, but added to makepkg's instead of replacing them (fix 1).
    # template-body: as Arch, for GCC 15+ (a typo in include/plugin.h).
    -D CMAKE_C_FLAGS="$CFLAGS -Wno-error -Wno-missing-field-initializers -DPFFFT_SIMD_DISABLE"
    -D CMAKE_CXX_FLAGS="$CXXFLAGS -Wno-error -Wno-error=template-body -Wno-missing-field-initializers -DPFFFT_SIMD_DISABLE"
    -D BUILD_JAVA_INTERFACE=0
    -S $pkgname-$pkgver
    -W no-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # export vars in profile.d
  install -vDm 755 "$srcdir/$pkgname.sh" -t "$pkgdir/etc/profile.d/"
  # rename extract executable due to name conflict with libextractor
  # https://github.com/csound/csound/issues/985
  mv -v "$pkgdir/usr/bin/extract" "$pkgdir/usr/bin/$pkgname-extract"
}
